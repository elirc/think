{
  "name": "tracevault",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "concurrently -k \"corepack pnpm --filter @tracevault/server dev\" \"corepack pnpm --filter @tracevault/web dev\"",
    "test": "vitest run",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "eslint .",
    "tree": "node scripts/tree.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.9",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^2.1.9"
  }
}
